# Copy to ".env" (git-ignored) and replace placeholders. All values below are placeholders only.
# Generate a BCrypt hash, e.g.:  htpasswd -bnBC 12 "" 'YourStrongPassword' | tr -d ':\n' | sed 's/$2y/$2a/'
# or with Spring CLI / any BCrypt tool. Prefix with {bcrypt}.

DATASPHERE_ADMIN_USERNAME=change-me
DATASPHERE_ADMIN_DISPLAY_NAME=Administrator
DATASPHERE_ADMIN_PASSWORD_HASH={bcrypt}$2a$12$REPLACE_WITH_YOUR_OWN_BCRYPT_HASH

DATASPHERE_PORT=8080
DATASPHERE_SESSION_TIMEOUT=30m
# Must be true when served over HTTPS (forced by the 'prod' profile)
DATASPHERE_COOKIE_SECURE=false
DATASPHERE_LOG_DIR=./logs

# Folder where migration projects (mappings, approvals) are saved. Database passwords are never saved here.
DATASPHERE_DATA_DIR=./data
# Hosts that connections may target. Required in production. Comma separated: host, *.suffix, IP or CIDR.
DATASPHERE_DB_ALLOWED_HOSTS=
